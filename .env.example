# ============================================================
# 抖音点赞监控 Agent · 环境变量模板
# 复制为 .env 后按需修改。不填也能跑（全部有默认值）。
# ============================================================

# ---------- 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# ---------- 存储：业务数据 ----------
# sqlite（默认，本地零依赖） | sqlite+feishu（双写：本地权威 + 飞书多维表格实时镜像，推荐） | feishu（多维表格为唯一存储）
# 双写模式：配置表在飞书里直接改「值」也能生效（阈值/调度时间两边都可控）。
# 注意：业务数据与 Graph 执行状态是两条独立支线，不要混用同一后端。
STORAGE_BACKEND=sqlite+feishu
SQLITE_PATH=data/app.db

# ---------- 存储：Graph 执行状态（评论子图的 interrupt 挂起靠它）----------
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_PATH=data/checkpoints.db

# ---------- 数据源降级链 ----------
# 从左到右依次尝试，全部失败才算采集失败。降级逻辑收在 collect_videos 节点内部。
# P0 只有 mock 可用；thirdparty 是 P1 占位；browser 已实现（见下）。
PROVIDER_CHAIN=thirdparty,browser,mock
LOOKBACK_DAYS=3

# ---------- browser provider（真实采集，推荐）----------
# 前提：一个专门给本项目用的 Chrome 用户目录，且已登录过抖音网页版。
# 一次性登录步骤：
#   1) BROWSER_HEADLESS=false（先填好 BROWSER_USER_DATA_DIR 再启动）
#   2) 启动项目 → 触发一次扫描 → 会弹出 Chrome 窗口 → 扫码登录抖音
#   3) 登录成功后停掉项目，BROWSER_HEADLESS=true，以后都无头跑
# 建议用户目录放在项目外（如 D:\chrome_profiles\douyin_agent），避免被误删。
BROWSER_USER_DATA_DIR=
BROWSER_HEADLESS=true
# 本机没装 Chrome 就用 Edge：msedge（都行，Playwright 原生支持）
BROWSER_CHANNEL=msedge
BROWSER_ACCOUNT_DELAY=8
BROWSER_MAX_SCROLLS=10

# ---------- 告警渠道 ----------
# local（默认，写入控制台与看板） | feishu_im（直发你飞书私聊） | feishu_card（飞书群 webhook）
# 可用 + 组合，例如 local+feishu_im = 本地记一笔 + 同时推飞书。全部渠道都成功才算「已送达」。
NOTIFIER_BACKEND=local

# 飞书群自定义机器人 webhook。不需要自建应用，群设置 → 群机器人 → 添加 → 自定义机器人。
FEISHU_WEBHOOK=

# 告警私聊对象（NOTIFIER_BACKEND 含 feishu_im 时用）。
# 留空会自动取「应用创建者」的 open_id —— 这个应用是你自己建的，创建者就是你，
# 所以个人使用通常留空即可。发给别人/群时才需要显式填：
#   open_id（ou_xxx）/ user_id / email / chat_id（oc_xxx，配合 type=chat_id）
FEISHU_NOTIFY_RECEIVE_ID=
FEISHU_NOTIFY_RECEIVE_ID_TYPE=open_id

# ---------- 调度 ----------
# 调度模式与间隔不在这里配——它们从数据库《配置表》读，改表即生效。
SCHEDULER_ENABLED=true
TIMEZONE=Asia/Shanghai

# ---------- 评论子图 ----------
ENABLE_COMMENT_GRAPH=true
# 扫描收尾时给在飞的评论子图留的收尾窗口（秒）。子图跑到"等待人工确认"即算收尾，
# 所以只在异常情况下才会被用满。设 0 = 不等（纯 fire-and-forget）。
COMMENT_DRAIN_TIMEOUT=8

# LLM 只用在「拟回复措辞」这一个节点。关掉则走模板兜底，全链路依然跑得通。
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------- 飞书应用凭证（STORAGE_BACKEND 含 feishu 时必填）----------
# 完整步骤见 README「5.2 双写」——两个最容易卡住的地方：
# ① 权限开通后**必须去「版本管理与发布」发布一个版本**，否则接口报 app_scope_not_applied；
# ② 应用建的表格归应用所有，你要么把链接分享改成「组织内可编辑」，要么把自己加成协作者。
# 体检工具：python tools/feishu_status.py
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ACCOUNTS=监控账号表
FEISHU_TABLE_SNAPSHOTS=视频快照表
FEISHU_TABLE_DELTAS=增量与告警表
FEISHU_TABLE_COMMENTS=评论命中表
FEISHU_TABLE_CONFIG=配置表
FEISHU_TABLE_ROUNDS=扫描轮次表
